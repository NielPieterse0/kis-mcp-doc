{
  "schema_version": 1,
  "id": "KIS-REPO-DIR-001",
  "title": "Repository Directory Grammar",
  "status": "active",
  "record_mode": "prescriptive",
  "version": "1.0.0",
  "top_level_directories": [
    ".github",
    ".work",
    "contracts",
    "evidence",
    "generated",
    "prescriptives",
    "publication",
    "scripts",
    "src",
    "tests",
    "tooling"
  ],
  "root_files": [
    ".editorconfig",
    ".gitattributes",
    ".gitignore",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "README.md",
    "SECURITY.md",
    "pyproject.toml",
    "uv.lock"
  ],
  "closed_subdirectories": {
    "prescriptives": [
      "documentation",
      "governance",
      "repository-governance",
      "work-management"
    ],
    ".github": [
      "workflows"
    ],
    "evidence": [
      "work-management"
    ],
    "src": [
      "kis_mcp_doc"
    ]
  },
  "contract_domains": [
    "documentation",
    "governance",
    "mrd",
    "publication",
    "repository-governance",
    "work-management"
  ],
  "recursive_slots": [
    "generated/**",
    "contracts/documentation/**",
    "contracts/governance/**",
    "contracts/mrd/**",
    "contracts/publication/**",
    "contracts/repository-governance/**",
    "contracts/work-management/**",
    ".work/changes/*"
  ],
  "reserved_workspace": {
    "path": ".work",
    "canonical_authority": false,
    "published": false,
    "required_as_product_input": false,
    "promotion_requires_grammar_amendment": true
  },
  "transient_non_governed": [
    ".git",
    ".venv",
    ".pytest_cache",
    ".ruff_cache",
    "__pycache__",
    "build",
    "*.egg-info"
  ],
  "placement_law": "Unknown persistent governed structure is invalid by default; amend this grammar before adding a new structural class."
}
