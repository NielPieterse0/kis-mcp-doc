      "role": "evidence"
    }
  ],
  "rules": [
    {
      "rule_id": "KIS-REPO-GOV-001",
      "statement": "Every persistent governed artefact MUST resolve to one primary semantic role.",
      "enforcement": "validator"
    },
    {
      "rule_id": "KIS-REPO-GOV-002",
      "statement": "Every prescriptive artefact and governed fact MUST resolve to exactly one canonical owner.",
      "enforcement": "validator"
    },
    {
      "rule_id": "KIS-REPO-GOV-003",
      "statement": "Every persistent governed directory MUST occupy a legal Directory Grammar slot.",
      "enforcement": "validator"
    },
    {
      "rule_id": "KIS-REPO-GOV-004",
      "statement": "Unknown persistent governed top-level directories and prescriptive domains MUST fail closed.",
      "enforcement": "validator"
    },
    {
      "rule_id": "KIS-REPO-GOV-005",
      "statement": "Generated outputs MUST remain projection-only and MUST NOT become write-back authority.",
      "enforcement": "generator"
    },
    {
      "rule_id": "KIS-REPO-GOV-006",
      "statement": "Each deterministic repository-governance rule MUST name a negative fixture proving prohibited state is detected.",
      "enforcement": "validator"
    },
    {
      "rule_id": "KIS-REPO-GOV-007",
      "statement": "Repository structure MUST grow by amending legal slots for demonstrated needs, not by creating speculative hierarchy.",
      "enforcement": "review"
    },
    {
      "rule_id": "KIS-REPO-GOV-008",
      "statement": ".work is the reserved KIS work/change namespace; it MUST NOT become canonical product authority or a route around persistent placement law.",
      "enforcement": "review"
    }
  ],
  "authority": {
    "canonical_owner": "KIS-REPO-GOV-001",
    "parent_authority": "C:/Projects/kis-mcp/AGENTS.md",
    "external_reference_posture": "evidence_only"
  }
}
