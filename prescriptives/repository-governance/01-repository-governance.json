{
  "schema_version": 1,
  "id": "KIS-REPO-GOV-001",
  "title": "Repository Governance",
  "status": "active",
  "record_mode": "prescriptive",
  "version": "1.0.0",
  "purpose": "Own repository-wide semantic roles, structural law, fact ownership, and enforceability expectations.",
  "semantic_roles": [
    {
      "role": "prescriptive",
      "question": "What should be true?",
      "authority": "may_own_governed_facts"
    },
    {
      "role": "implementation",
      "question": "What makes it true?",
      "authority": "implements_prescriptions"
    },
    {
      "role": "derived_generated",
      "question": "What results from it?",
      "authority": "projection_only_no_writeback"
    },
    {
      "role": "verification",
      "question": "What checks it?",
      "authority": "checks_prescriptions_and_state"
    },
    {
      "role": "evidence",
      "question": "What proves it?",
      "authority": "records_bounded_results"
    }
  ],
  "classification_rules": [
    {
      "pattern": "AGENTS.md",
      "role": "prescriptive"
    },
    {
      "pattern": "prescriptives/**",
      "role": "prescriptive"
    },
    {
      "pattern": "contracts/**",
      "role": "prescriptive"
    },
    {
      "pattern": "publication/**",
      "role": "prescriptive"
    },
    {
      "pattern": ".github/CODEOWNERS",
      "role": "prescriptive"
    },
    {
      "pattern": "generated/**",
      "role": "derived_generated"
    },
    {
      "pattern": "README.md",
      "role": "derived_generated"
    },
    {
      "pattern": "CONTRIBUTING.md",
      "role": "derived_generated"
    },
    {
      "pattern": "SECURITY.md",
      "role": "derived_generated"
    },
    {
      "pattern": ".github/pull_request_template.md",
      "role": "derived_generated"
    },
    {
