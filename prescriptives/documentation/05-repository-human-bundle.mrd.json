    "relationship_policy": {
      "typed": true,
      "authority_separate_from_dependency": true,
      "observed_and_derived_distinguished": true,
      "unsupported_inference_forbidden": true
    },
    "requirements": [
      {
        "rule_id": "KIS-DOC-REP-001",
        "statement": "The repository human bundle MUST be generated from current repository machine and executable sources and MUST NOT become write-back authority.",
        "enforcement": "generator"
      },
      {
        "rule_id": "KIS-DOC-REP-002",
        "statement": "Work Management MUST remain a separately governed standalone publication family, MUST NOT be consolidated into the kis-mcp-doc repository human bundle, and MUST NOT be published into the kis-mcp-doc reader-facing GitHub Pages site, public search index, or Pages release archive.",
        "enforcement": "validator"
      },
      {
        "rule_id": "KIS-DOC-REP-003",
        "statement": "Artefact metadata MUST preserve stable repository identity, canonical path, authority direction, content identity, provenance, and freshness evidence where those facts are available.",
        "enforcement": "generator"
      },
      {
        "rule_id": "KIS-DOC-REP-004",
        "statement": "Typed relationships MUST distinguish source-declared observations from relationships derived by deterministic repository policy.",
        "enforcement": "generator"
      },
      {
        "rule_id": "KIS-DOC-REP-005",
        "statement": "Exact containing Git revision MUST be bound through external Git or publication evidence when embedding it would create circular tracked-content identity.",
        "enforcement": "review"
      },
      {
        "rule_id": "KIS-DOC-REP-006",
        "statement": "Publication, search, site, and release surfaces MUST consume the repository bundle through the canonical publication-family registry, and every registered family MUST explicitly declare whether it is published to the kis-mcp-doc Pages portal so that site exposure cannot be inferred or silently expanded.",
        "enforcement": "validator"
      },
      {
        "rule_id": "KIS-DOC-REP-007",
        "statement": "Verification MUST detect source, inventory, relationship, generated-file, site, search, and release drift before completion.",
        "enforcement": "generator"
      }
    ]
  }
