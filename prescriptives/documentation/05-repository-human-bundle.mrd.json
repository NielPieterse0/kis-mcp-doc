  "content": {
    "concern": "current_state_repository_human_bundle",
    "purpose": "Generate a complete current-state human projection of kis-mcp-doc and a deterministic artefact metadata and relationship graph without creating another authority.",
    "authority": {
      "write_back": false,
      "canonical_sources_remain_authoritative": true,
