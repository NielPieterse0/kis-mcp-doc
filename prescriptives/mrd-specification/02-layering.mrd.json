  "content": {
    "concern": "layering",
    "section_order": 4,
    "heading": "Layering",
    "purpose": "Define authority ordering for MRD dependencies.",
    "layers": [
      {
        "code": "L0",
        "name": "Foundational semantics",
        "interpretation": "Defines meaning."
      },
      {
        "code": "L1",
        "name": "Constraints and governance",
        "interpretation": "Restricts permitted meaning or behavior."
      },
      {
        "code": "L2",
        "name": "Decisions and workflows",
        "interpretation": "Determines behavior."
      },
      {
        "code": "L3",
        "name": "Configuration and mappings",
        "interpretation": "Selects or configures allowed behavior."
      },
      {
        "code": "L4",
        "name": "Evaluation and agent behavior",
        "interpretation": "Measures or evaluates behavior."
      },
      {
        "code": "L5",
        "name": "Evidence and observations",
        "interpretation": "Records what happened."
      }
    ],
    "rules": [
      {
        "rule_id": "KIS-MRD-LAYER-001",
        "statement": "An MRD MAY depend only on an MRD in the same layer or a higher-authority layer with a lower layer number.",
        "enforcement": "validator"
      },
      {
        "rule_id": "KIS-MRD-LAYER-002",
        "statement": "An MRD MUST NOT depend on an MRD in a lower-authority layer with a higher layer number.",
        "enforcement": "validator"
      },
      {
        "rule_id": "KIS-MRD-LAYER-003",
        "statement": "Layer assignment expresses authority ordering, not storage location or implementation order.",
        "enforcement": "review"
      }
    ],
    "examples": [
      {
        "source": "L3",
        "target": "L2",
        "valid": true
      },
