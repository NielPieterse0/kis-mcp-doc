  "content": {
    "concern": "validation",
    "section_order": 9,
    "heading": "Validation and Enforcement",
    "purpose": "Define how structural and semantic governance requirements are checked, which enforcement mode applies, and which blocking failures must fail closed.",
    "dimensions": [
      {
        "name": "structural",
        "checks": [
          "required fields present",
          "identifier shape",
          "schema-compatible envelope and payload",
          "exactly one owner for each governance concern",
          "public composed governance MRD profile"
        ]
      },
      {
        "name": "applicability",
        "checks": [
          "all 47 catalog types have one selection trigger",
          "applicability catalog matches classification catalog exactly",
          "minimum-sufficient selection is prescribed",
          "extension path remains versioned"
        ]
      },
      {
        "name": "ownership",
        "checks": [
          "one canonical owner is prescribed for each governed fact",
          "dependency relationship labels use the governed relationship vocabulary",
          "generated projections remain non-authoritative"
        ]
      },
      {
        "name": "dependency",
        "checks": [
          "all targets resolve",
          "layer direction valid",
          "no cycles",
          "no duplicate edges",
          "stable dependency identities"
        ]
      },
      {
        "name": "provenance",
        "checks": [
          "source kinds valid",
          "repo sources resolve",
          "external references are fingerprinted",
          "source fingerprint matches source set",
          "no inferred normative facts"
        ]
      },
      {
        "name": "lifecycle",
        "checks": [
          "record mode recognized",
          "status valid for mode",
          "active authority resolves",
          "EVD descriptive posture",
          "META meta posture",
          "supersession targets resolve"
        ]
      },
      {
        "name": "operator_behavior",
        "checks": [
          "kis-op phases are complete and ordered",
          "blocking stop conditions are explicit",
          "generated review surface is downstream of validated authority"
        ]
      }
    ],
    "result_contract": {
      "status_values": [
        "valid",
        "invalid"
      ],
      "checks": [
        "classification",
        "applicability",
        "ownership",
        "layering",
        "dependencies",
        "provenance",
        "lifecycle",
        "operator_behavior",
        "schema"
      ],
      "diagnostics_required_on_failure": true
    },
    "reason_codes": [
      "MRD_SCHEMA_INVALID",
      "MRD_RULE_ID_DUPLICATE",
      "MRD_GOVERNANCE_CONCERN_MISSING",
      "MRD_GOVERNANCE_CONCERN_DUPLICATE",
      "MRD_ID_CLASS_TYPE_MISMATCH",
      "MRD_CLASS_UNKNOWN",
      "MRD_TYPE_INVALID",
      "MRD_CATALOG_COUNT_MISMATCH",
      "MRD_LAYER_INVALID",
      "MRD_DEPENDENCY_UNRESOLVED",
      "MRD_DEPENDENCY_LAYER_VIOLATION",
      "MRD_DEPENDENCY_CYCLE",
      "MRD_DEPENDENCY_DUPLICATE",
      "MRD_SOURCE_UNRESOLVED",
      "MRD_SOURCE_FINGERPRINT_MISMATCH",
      "MRD_SOURCE_HASH_MISMATCH",
      "MRD_NORMATIVE_INFERENCE_PROHIBITED",
      "MRD_RECORD_MODE_INVALID",
      "MRD_STATUS_INVALID",
      "MRD_EVD_RECORD_MODE_INVALID",
      "MRD_META_RECORD_MODE_INVALID",
      "MRD_SUPERSESSION_UNRESOLVED",
      "MRD_CLASS_CATALOG_MISMATCH",
      "MRD_LAYER_CATALOG_MISMATCH",
      "MRD_RECORD_MODE_CATALOG_MISMATCH",
      "MRD_META_FACT_QUALITY_INVALID",
      "MRD_VALIDATION_CONTRACT_MISMATCH",
      "MRD_APPLICABILITY_CATALOG_MISMATCH",
      "MRD_RELATIONSHIP_UNKNOWN",
      "MRD_OPERATOR_BEHAVIOR_INVALID",
      "MRD_ENFORCEMENT_BINDING_INVALID"
    ],
    "rules": [
      {
        "rule_id": "KIS-MRD-VAL-001",
        "statement": "Every MRD MUST pass structural, dependency, provenance, and lifecycle validation before it is accepted as valid.",
        "enforcement": "validator"
      },
      {
        "rule_id": "KIS-MRD-VAL-002",
        "statement": "Validation failures MUST emit stable reason codes and machine-readable diagnostics.",
        "enforcement": "validator"
      },
      {
        "rule_id": "KIS-MRD-VAL-003",
        "statement": "A validation result MUST report classification, layering, dependencies, provenance, lifecycle, and schema check status.",
        "enforcement": "validator"
      },
      {
        "rule_id": "KIS-MRD-VAL-004",
        "statement": "Governance MRDs MUST validate through the public composed governance MRD profile, which binds the reusable core envelope to governance content.",
        "enforcement": "schema"
      },
      {
        "rule_id": "KIS-MRD-VAL-005",
        "statement": "Any structural schema failure in the governance MRD set MUST short-circuit semantic validation for the entire set, because cross-record semantics are valid only over a structurally valid governance set.",
        "enforcement": "validator"
      }
    ],
    "enforcement_modes": [
      {
        "mode": "schema",
        "meaning": "JSON Schema rejects structurally invalid authority before semantic checks.",
        "blocking": true
      },
      {
        "mode": "validator",
        "meaning": "Deterministic semantic validation emits stable machine-readable reason codes.",
        "blocking": true
      },
      {
        "mode": "workflow",
        "meaning": "KIS/kis-op governed workflow prevents prohibited state transitions or unadmitted mutation.",
        "blocking": true
      },
      {
        "mode": "generator",
        "meaning": "Deterministic generation and stale-output verification enforce one-way source-to-view behavior.",
        "blocking": true
      },
      {
        "mode": "review",
        "meaning": "Human or agent review is required where semantic adequacy cannot be proven deterministically.",
        "blocking": true
      }
    ]
  }
}
