    "concern": "layering",
    "section_order": 2,
    "heading": "Layering",
    "purpose": "Define authority ordering for MRD dependencies.",
    "layers": [
      {
        "code": "L0",
        "name": "Foundational semantics",
        "interpretation": "Defines meaning."
      },
      {
        "code": "L1",
