      },
      {
        "code": "L5",
        "name": "Evidence and observations",
        "interpretation": "Records what happened."
      }
    ],
    "rules": [
      {
        "rule_id": "KIS-MRD-LAYER-001",
        "statement": "An MRD MAY depend only on an MRD in the same layer or a higher-authority layer with a lower layer number."
      },
      {
        "rule_id": "KIS-MRD-LAYER-002",
        "statement": "An MRD MUST NOT depend on an MRD in a lower-authority layer with a higher layer number."
      },
      {
        "rule_id": "KIS-MRD-LAYER-003",
        "statement": "Layer assignment expresses authority ordering, not storage location or implementation order."
      }
    ],
