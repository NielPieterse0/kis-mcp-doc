  "content": {
    "concern": "classification",
    "section_order": 1,
    "heading": "Classification",
    "purpose": "Define the stable functional vocabulary used to classify KIS MRDs without coupling classification to repository layout.",
    "classes": [
      {
        "code": "SEM",
        "name": "Semantics",
        "definition": "Defines canonical meaning, vocabulary, entities, enumerations, ontologies, registries, domains, and assertions."
      },
      {
        "code": "CON",
        "name": "Constraints",
        "definition": "Restricts permitted meaning or behavior through validation, boundaries, policy, and constraint contracts."
      },
      {
        "code": "DEC",
        "name": "Decisions",
        "definition": "Determines outcomes through decision tables, trees, and scoring models."
      },
      {
        "code": "WRK",
        "name": "Workflows",
        "definition": "Defines permitted state transitions, processes, approvals, phases, workflows, and actions."
      },
      {
        "code": "CFG",
        "name": "Configuration",
        "definition": "Selects or parameterizes allowed behavior through environments, flags, and runtime parameters."
      },
      {
        "code": "MAP",
        "name": "Mappings",
        "definition": "Defines deterministic translation between fields, formats, or versions."
      },
      {
        "code": "CTR",
        "name": "Contracts",
        "definition": "Defines externally or internally consumable API, event, and service interfaces."
      },
      {
        "code": "MAN",
        "name": "Manifests",
        "definition": "Declares package, bill-of-materials, release, skill, and action inventories."
      },
      {
        "code": "PRM",
        "name": "Prompts",
        "definition": "Defines system, role, context, and tool prompt behavior."
      },
      {
        "code": "EVL",
        "name": "Evaluations",
        "definition": "Defines tests, rubrics, and benchmarks used to measure conformance or quality."
      },
      {
        "code": "EVD",
        "name": "Evidence",
        "definition": "Records logs, approvals, lineage, and test-result observations."
      },
      {
        "code": "META",
        "name": "Derived metadata",
        "definition": "Contains generated indexes, dependency maps, and metadata maps; never primary authority."
      }
    ],
