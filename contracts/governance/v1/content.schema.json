        "fact_qualities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "quality",
              "meaning"
            ]
          }
        },
        "source_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "resolution"
            ]
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "statement"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "concern",
        "section_order",
        "heading",
        "purpose",
        "lifecycles",
        "rules"
      ],
      "properties": {
        "concern": {
          "const": "lifecycle"
        },
        "section_order": {
          "const": 5
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "lifecycles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "record_mode",
              "states",
              "transitions"
            ]
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "statement"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "concern",
        "section_order",
        "heading",
        "purpose",
        "dimensions",
        "result_contract",
        "reason_codes",
        "rules"
      ],
      "properties": {
        "concern": {
          "const": "validation"
        },
        "section_order": {
          "const": 6
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "checks"
            ]
          }
        },
        "result_contract": {
          "type": "object",
          "required": [
            "status_values",
            "checks",
            "diagnostics_required_on_failure"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "statement"
            ]
          }
        }
      },
      "additionalProperties": false
    }
