{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/contracts/governance/v1/content.schema.json",
  "title": "KIS Core Governance MRD Content",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "concern",
        "section_order",
        "heading",
        "purpose",
        "classes",
        "type_catalog",
        "catalog_policy",
        "rules"
      ],
      "properties": {
        "concern": {
          "const": "classification"
        },
        "section_order": {
          "const": 1
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "code",
              "name",
              "definition"
            ]
          }
        },
        "type_catalog": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "class",
              "type",
              "code",
              "name",
              "canonical_format"
            ]
          }
        },
        "catalog_policy": {
          "type": "object",
          "required": [
            "expected_type_count",
            "extension_posture"
          ]
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "statement"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "concern",
        "section_order",
        "heading",
        "purpose",
        "layers",
        "rules",
        "examples"
