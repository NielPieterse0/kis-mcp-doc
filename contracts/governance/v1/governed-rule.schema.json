{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/contracts/governance/v1/governed-rule.schema.json",
  "title": "KIS Governed Rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "construct",
    "statement",
    "rationale",
    "scope",
    "applicability",
    "authoritative_owner",
    "implementation",
    "verification",
    "evidence",
    "lifecycle"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^KIS-[A-Z0-9-]+-[0-9]{3}$"
    },
    "construct": {
      "const": "rule"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "object",
      "required": [
        "summary",
        "origin"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "object",
          "required": [
            "kind",
            "id",
            "locator"
          ],
          "properties": {
            "kind": {
              "enum": [
                "github_issue",
                "governed_change",
                "repository_obligation"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "applies_to",
        "excludes"
      ],
      "properties": {
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "applicability": {
      "type": "string",
      "minLength": 1
    },
    "authoritative_owner": {
      "type": "string",
      "minLength": 1
    },
    "implementation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact",
          "control"
        ],
        "properties": {
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "control": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "method",
        "validator",
        "entry_point",
        "execution_point",
        "expected_result",
        "failure_code",
        "negative_fixture",
        "residual_review"
      ],
      "properties": {
        "method": {
          "enum": [
            "deterministic",
            "deterministic_plus_residual_review"
          ]
        },
        "validator": {
          "type": "string",
          "minLength": 1
        },
        "entry_point": {
          "type": "string",
          "minLength": 1
        },
        "execution_point": {
          "type": "string",
          "minLength": 1
        },
        "expected_result": {
          "type": "string",
          "minLength": 1
        },
        "failure_code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "negative_fixture": {
          "type": "string",
          "pattern": "^test_[a-z0-9_]+$"
        },
        "residual_review": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "type",
        "location",
        "evaluated_revision",
        "input_provenance",
        "conformance_states"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "evaluated_revision": {
          "type": "string"
        },
        "input_provenance": {
          "type": "string"
        },
        "conformance_states": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "status",
        "supersedes",
        "superseded_by"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "active",
            "deprecated",
            "superseded",
            "retired"
          ]
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
