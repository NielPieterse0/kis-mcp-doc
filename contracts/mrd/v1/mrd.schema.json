{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/contracts/mrd/v1/mrd.schema.json",
  "title": "KIS MRD Core Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["_mrd", "content"],
  "properties": {
    "_mrd": {"$ref": "#/$defs/envelope"},
    "content": {"type": "object"}
  },
  "$defs": {
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "id", "title", "module", "class", "type", "layer",
        "record_mode", "status", "version", "dependencies", "provenance",
        "supersedes", "superseded_by"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "id": {"type": "string", "pattern": "^KIS-[A-Z0-9]+-[A-Z]{3,4}-[A-Z]{3,4}-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 3},
        "module": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "class": {"type": "string", "pattern": "^[A-Z]{3,4}$"},
        "type": {"type": "string", "pattern": "^[A-Z]{3,4}$"},
        "layer": {"type": "string", "pattern": "^L[0-5]$"},
        "record_mode": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
        "provenance": {"$ref": "#/$defs/provenance"},
        "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "superseded_by": {"type": ["string", "null"]}
      }
    },    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship"],
      "properties": {
        "mrd_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "pattern": "^repo:.+"},
        "relationship": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {"required": ["mrd_id"], "not": {"required": ["source"]}},
        {"required": ["source"], "not": {"required": ["mrd_id"]}}
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "source_fingerprint", "fact_quality"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        },
        "source_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "fact_quality": {"type": "string", "minLength": 1}
      }
    },    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "role", "locator"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "revision": {"type": ["string", "null"]},
        "sha256": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          ]
        }
      }
    }
  }
}
